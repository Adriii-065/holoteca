# Copia este archivo como ".env" (sin el ".example") y rellena tus datos.
# El archivo .env NUNCA se sube a internet ni se comparte: ahi vive tu contrasena.

# Puerto en el que arranca la web en tu ordenador
PORT=3000

# Dejalo vacio o en "development" en tu ordenador. Ponlo en "production"
# SOLO en Render (o el hosting que uses) - hace que la cookie de sesion
# viaje de forma mas segura cuando la web esta detras de HTTPS de verdad.
NODE_ENV=development

# Frase secreta para las sesiones de admin. Pon cualquier texto largo y unico.
SESSION_SECRET=cambia-esto-por-una-frase-larga-y-aleatoria

# --- Acceso de administrador (tu, el unico que puede subir cartas) ---
ADMIN_USERNAME=admin
# No pongas aqui tu contrasena en texto plano. Genera el hash con:
#   npm run hash-password
# y pega el resultado abajo.
ADMIN_PASSWORD_HASH=

# El telefono/nombre de Bizum, las credenciales de PayPal y las de Cloudinary
# (fotos) se configuran desde el panel de administracion (pestana
# "Ajustes"), no aqui.

# Opcional: solo hace falta si despliegas en un hosting de disco no
# persistente (por ejemplo el plan gratis de Render) y quieres que tus
# cartas/pedidos no se borren en cada reinicio. Ver el punto 10 del README.
# Si lo dejas vacio, todo se guarda en db/data.json como siempre.
MONGODB_URI=
